@page "/forecast-bills"
@inject IStorageService StorageService
@inject ITimeSeriesForecaster Forecaster
@inject NavigationManager NavManager

<PageTitle>PowerPulse — Forecast & Electricity Bills</PageTitle>

<div class="dashboard-header">
    <div>
        <h1 class="header-greeting">Billing Cycle Forecast & Bill Estimator</h1>
        <div class="header-subtitle">Estimated electricity charges, tariff bracket breakdowns, and month-end projections</div>
    </div>
    <div class="header-actions">
        <NavLink href="settings" class="btn-pulse-outline">
            Configure Tariff Plan
        </NavLink>
    </div>
</div>

@if (allReadings.Count == 0)
{
    <div class="pulse-card empty-state">
        <h2 class="empty-state-title">No Consumption Data Loaded</h2>
        <p class="empty-state-desc">Import energy data or load sample data to generate bill estimations and projections.</p>
        <NavLink href="import" class="btn-pulse">Import Data</NavLink>
    </div>
}
else
{
    <!-- Forecast & Billing KPI Row -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-title">
                <span>Observed Cycle Usage</span>
                <span class="badge-tag">Actual</span>
            </div>
            <div class="kpi-value-container">
                <span class="kpi-value">@(forecast?.ObservedKwh.ToString("N1"))</span>
                <span class="kpi-unit">kWh</span>
            </div>
            <div>
                <span style="font-size: 12px; color: var(--text-secondary);">
                    Across <strong>@(forecast?.ObservedDays)</strong> observed cycle days
                </span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-title">
                <span>Projected Cycle Total</span>
                <span class="badge-tag">Forecast</span>
            </div>
            <div class="kpi-value-container">
                <span class="kpi-value">@(forecast?.ProjectedTotalKwh.ToString("N1"))</span>
                <span class="kpi-unit">kWh</span>
            </div>
            <div>
                <span style="font-size: 12px; color: var(--text-secondary);">
                    +@(forecast?.ExpectedRemainingKwh.ToString("N1")) kWh in @(forecast?.RemainingDays) remaining days
                </span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-title">
                <span>Projected Month Bill</span>
                <span class="badge-tag">Estimated</span>
            </div>
            <div class="kpi-value-container">
                <span class="kpi-value">@(tariff?.Currency)@(forecast?.ProjectedBill.ToString("N2"))</span>
            </div>
            <div>
                @if (forecast?.DifferenceVsPreviousMonthKwh.HasValue == true)
                {
                    var isUp = forecast.DifferenceVsPreviousMonthKwh.Value > 0;
                    <span class="kpi-badge @(isUp ? "badge-negative" : "badge-positive")">
                        @(isUp ? "↑ +" : "↓ ")@forecast.DifferenceVsPreviousMonthKwh.Value.ToString("N1") kWh vs last cycle
                    </span>
                }
                else
                {
                    <span style="font-size: 12px; color: var(--text-secondary);">No previous cycle baseline</span>
                }
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-title">
                <span>Forecast Method</span>
                <span class="badge-tag">@forecastMethod</span>
            </div>
            <div class="kpi-value-container">
                <span class="kpi-value" style="font-size: 18px;">
                    @(forecastMethod == ForecastMethod.RecentSevenDays ? forecast?.Recent7DaysAverageKwh.ToString("N1") : forecast?.DailyAverageKwh.ToString("N1"))
                </span>
                <span class="kpi-unit">kWh/day</span>
            </div>
            <div>
                <div class="d-flex gap-1 mt-1">
                    <button class="btn btn-sm @(forecastMethod == ForecastMethod.RecentSevenDays ? "btn-success" : "btn-outline-secondary") py-0 px-2"
                            style="font-size: 11px;" @onclick="() => ToggleForecastMethod(ForecastMethod.RecentSevenDays)">
                        7-Day Rolling
                    </button>
                    <button class="btn btn-sm @(forecastMethod == ForecastMethod.AverageDaily ? "btn-success" : "btn-outline-secondary") py-0 px-2"
                            style="font-size: 11px;" @onclick="() => ToggleForecastMethod(ForecastMethod.AverageDaily)">
                        Cycle Avg
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(forecast?.CoverageWarning))
    {
        <div class="alert alert-warning mb-4" style="font-size: 13px;">
            ⚠️ <strong>Data Coverage Advisory:</strong> @forecast.CoverageWarning
        </div>
    }

    <!-- Current Billing Cycle Detailed Invoice Estimate -->
    <div class="pulse-card">
        <div class="card-header-flex">
            <div>
                <h2 class="card-title-lg">Current Cycle Bill Calculation Breakdown</h2>
                <div class="card-subtitle-sm">
                    Billing Period: @currentCycleStart.ToString("MMM dd, yyyy") to @currentCycleEnd.ToString("MMM dd, yyyy") (Cycle Day: @(profile?.BillingCycleStartDay ?? 1))
                </div>
            </div>
            <div>
                <span class="badge bg-secondary" style="font-size: 12px;">Tariff Model: @(tariff?.Type)</span>
            </div>
        </div>

        @if (currentCycleBill != null)
        {
            <div class="row g-4 mb-4">
                <div class="col-md-3">
                    <div class="p-3 border rounded" style="background: #FAFAFC;">
                        <div style="font-size: 12px; color: var(--text-secondary); text-transform: uppercase;">Energy Charges</div>
                        <div style="font-size: 22px; font-weight: 700; color: var(--text-primary);">
                            @(tariff?.Currency)@currentCycleBill.EnergyCharges.ToString("N2")
                        </div>
                        <div style="font-size: 11px; color: var(--text-secondary); margin-top: 4px;">
                            For @currentCycleBill.TotalKwh.ToString("N1") consumed kWh
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="p-3 border rounded" style="background: #FAFAFC;">
                        <div style="font-size: 12px; color: var(--text-secondary); text-transform: uppercase;">Fixed Charges</div>
                        <div style="font-size: 22px; font-weight: 700; color: var(--text-primary);">
                            @(tariff?.Currency)@currentCycleBill.FixedCharges.ToString("N2")
                        </div>
                        <div style="font-size: 11px; color: var(--text-secondary); margin-top: 4px;">Monthly customer access charge</div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="p-3 border rounded" style="background: #FAFAFC;">
                        <div style="font-size: 12px; color: var(--text-secondary); text-transform: uppercase;">Taxes & Surcharges</div>
                        <div style="font-size: 22px; font-weight: 700; color: var(--text-primary);">
                            @(tariff?.Currency)@currentCycleBill.TaxAmount.ToString("N2")
                        </div>
                        <div style="font-size: 11px; color: var(--text-secondary); margin-top: 4px;">Rate: @currentCycleBill.TaxPercentage.ToString("N1")% on subtotal</div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="p-3 border rounded" style="background: #F0FDF4; border-color: var(--primary-green) !important;">
                        <div style="font-size: 12px; color: var(--deep-green); text-transform: uppercase; font-weight: 600;">Estimated Cycle Bill</div>
                        <div style="font-size: 22px; font-weight: 700; color: var(--primary-green);">
                            @(tariff?.Currency)@currentCycleBill.TotalEstimatedBill.ToString("N2")
                        </div>
                        <div style="font-size: 11px; color: var(--deep-green); margin-top: 4px;">Subtotal + Taxes</div>
                    </div>
                </div>
            </div>

            <!-- Tiered / Slab Details Table (if Slab Tariff) -->
            @if (tariff?.Type == TariffType.Slab && currentCycleBill.SlabBreakdowns.Count > 0)
            {
                <h3 style="font-size: 14px; font-weight: 700; margin-bottom: 8px;">Tiered Consumption Slabs</h3>
                <div class="table-responsive mb-4">
                    <table class="pulse-table">
                        <thead>
                            <tr>
                                <th>Tier Bracket</th>
                                <th>Consumption in Slab</th>
                                <th>Rate per kWh</th>
                                <th>Amount (@(tariff.Currency))</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in currentCycleBill.SlabBreakdowns)
                            {
                                <tr>
                                    <td><strong>@s.Label</strong></td>
                                    <td>@s.KwhInSlab.ToString("N1") kWh</td>
                                    <td>@(tariff.Currency)@s.RatePerKwh.ToString("N3")</td>
                                    <td>@(tariff.Currency)@s.Amount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- Time of Use Details Table (if TOU Tariff) -->
            @if (tariff?.Type == TariffType.TimeOfUse && currentCycleBill.TimeOfUseBreakdowns.Count > 0)
            {
                <h3 style="font-size: 14px; font-weight: 700; margin-bottom: 8px;">Time-of-Use Rate Bands</h3>
                <div class="table-responsive mb-4">
                    <table class="pulse-table">
                        <thead>
                            <tr>
                                <th>Band Name</th>
                                <th>Consumption in Band</th>
                                <th>Band Rate per kWh</th>
                                <th>Amount (@(tariff.Currency))</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in currentCycleBill.TimeOfUseBreakdowns)
                            {
                                <tr>
                                    <td><strong>@b.BandName</strong></td>
                                    <td>@b.KwhInBand.ToString("N1") kWh</td>
                                    <td>@(tariff.Currency)@b.RatePerKwh.ToString("N3")</td>
                                    <td>@(tariff.Currency)@b.Amount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- Actual Imported Bill Comparison (if imported data contains utility cost) -->
            @if (currentCycleBill.ActualImportedBill.HasValue)
            {
                <div class="p-3 border rounded mb-3" style="background: #FAFAFC;">
                    <div style="font-size: 14px; font-weight: 700; margin-bottom: 4px;">Actual Utility Bill Comparison</div>
                    <div class="d-flex gap-4 align-items-center">
                        <div>Actual Invoiced Bill: <strong>@(tariff?.Currency)@currentCycleBill.ActualImportedBill.Value.ToString("N2")</strong></div>
                        <div>Estimated Calculated Bill: <strong>@(tariff?.Currency)@currentCycleBill.TotalEstimatedBill.ToString("N2")</strong></div>
                        <div>Difference: <strong>@(tariff?.Currency)@(currentCycleBill.Difference?.ToString("N2"))</strong></div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Methodology Disclaimer -->
    <div class="pulse-card" style="background: #FFFBEB; border-color: #FCD34D;">
        <div style="font-size: 13px; color: #92400E;">
            <strong>Analytical Disclaimer:</strong> Projections use rolling statistical extrapolation (Month-to-date observed consumption + projected daily usage over remaining days).
            Electricity bill estimates depend on user-configured tariffs and may not reflect utility surcharges, seasonal fuel riders, or peak demand ratchets.
        </div>
    </div>
}

@code {
    private List<EnergyReading> allReadings = new();
    private HouseholdProfile? profile;
    private TariffPlan? tariff;
    private ForecastResult? forecast;
    private BillEstimate? currentCycleBill;

    private ForecastMethod forecastMethod = ForecastMethod.RecentSevenDays;
    private DateTimeOffset currentCycleStart;
    private DateTimeOffset currentCycleEnd;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        profile = await StorageService.GetProfileAsync();
        tariff = await StorageService.GetTariffAsync();
        allReadings = await StorageService.GetAllReadingsAsync();

        if (allReadings.Count > 0 && tariff != null)
        {
            int cycleDay = profile?.BillingCycleStartDay ?? 1;
            DateTimeOffset latestDate = allReadings.Max(r => r.Timestamp);

            // Determine cycle bounds
            int day = Math.Clamp(cycleDay, 1, 28);
            DateTime start;
            if (latestDate.Day >= day)
            {
                start = new DateTime(latestDate.Year, latestDate.Month, day);
            }
            else
            {
                var prev = latestDate.AddMonths(-1);
                start = new DateTime(prev.Year, prev.Month, day);
            }

            DateTime end = start.AddMonths(1);
            currentCycleStart = new DateTimeOffset(start, latestDate.Offset);
            currentCycleEnd = new DateTimeOffset(end, latestDate.Offset);

            // Generate forecast
            forecast = Forecaster.ForecastCycleConsumption(
                allReadings, tariff, cycleDay, forecastMethod);

            // Current cycle observed bill
            var cycleReadings = allReadings
                .Where(r => r.Timestamp >= currentCycleStart && r.Timestamp < currentCycleEnd)
                .ToList();
            double cycleTotalKwh = cycleReadings.Sum(r => r.ConsumptionKwh);

            decimal? actualCost = cycleReadings.Any(r => r.Cost.HasValue) ? cycleReadings.Where(r => r.Cost.HasValue).Sum(r => r.Cost!.Value) : null;

            currentCycleBill = TariffCalculator.CalculateBill(
                tariff, cycleTotalKwh, cycleReadings, actualCost, currentCycleStart, currentCycleEnd);
        }
    }

    private void ToggleForecastMethod(ForecastMethod method)
    {
        forecastMethod = method;
        if (tariff != null)
        {
            int cycleDay = profile?.BillingCycleStartDay ?? 1;
            forecast = Forecaster.ForecastCycleConsumption(
                allReadings, tariff, cycleDay, forecastMethod);
        }
    }
}
