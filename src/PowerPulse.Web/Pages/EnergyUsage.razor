@page "/energy-usage"
@inject IStorageService StorageService
@inject IJSRuntime JS

<PageTitle>PowerPulse — Energy Usage Analytics</PageTitle>

<div class="dashboard-header">
    <div>
        <h1 class="header-greeting">Energy Consumption Analytics</h1>
        <div class="header-subtitle">In-depth statistical breakdown and historical load profiles</div>
    </div>

    <!-- Date Filter Controls -->
    <div class="header-actions">
        <div class="date-selector-group" role="group" aria-label="Date Range Filter">
            <button class="date-selector-btn @(selectedOption == DateRangeOption.Last7Days ? "active" : "")"
                    @onclick="() => SetDateRange(DateRangeOption.Last7Days)">7D</button>
            <button class="date-selector-btn @(selectedOption == DateRangeOption.Last30Days ? "active" : "")"
                    @onclick="() => SetDateRange(DateRangeOption.Last30Days)">30D</button>
            <button class="date-selector-btn @(selectedOption == DateRangeOption.CurrentMonth ? "active" : "")"
                    @onclick="() => SetDateRange(DateRangeOption.CurrentMonth)">This Month</button>
            <button class="date-selector-btn @(selectedOption == DateRangeOption.PreviousMonth ? "active" : "")"
                    @onclick="() => SetDateRange(DateRangeOption.PreviousMonth)">Last Month</button>
            <button class="date-selector-btn @(selectedOption == DateRangeOption.CurrentBillingCycle ? "active" : "")"
                    @onclick="() => SetDateRange(DateRangeOption.CurrentBillingCycle)">Billing Cycle</button>
        </div>
    </div>
</div>

@if (allReadings.Count == 0)
{
    <div class="pulse-card empty-state">
        <h2 class="empty-state-title">No Energy Data Available</h2>
        <p class="empty-state-desc">Import data from CSV to view detailed energy analytics.</p>
        <NavLink href="import" class="btn-pulse">Go to Import</NavLink>
    </div>
}
else
{
    <!-- Analytics KPI Row -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-title">
                <span>Daily Average</span>
                <span class="badge-tag">Mean</span>
            </div>
            <div class="kpi-value-container">
                <span class="kpi-value">@comparison.CurrentDailyAverageKwh.ToString("N1")</span>
                <span class="kpi-unit">kWh/day</span>
            </div>
            <div>
                <span style="font-size: 12px; color: var(--text-secondary);">
                    Previous period: @comparison.PreviousDailyAverageKwh.ToString("N1") kWh/d
                </span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-title">
                <span>Weekday vs Weekend</span>
                <span class="badge-tag">Habits</span>
            </div>
            <div class="kpi-value-container">
                <span class="kpi-value">@comparison.WeekendAverageDailyKwh.ToString("N1")</span>
                <span class="kpi-unit">kWh (Wkend)</span>
            </div>
            <div>
                <span style="font-size: 12px; color: var(--text-secondary);">
                    Weekday avg: <strong>@comparison.WeekdayAverageDailyKwh.ToString("N1")</strong> kWh/d
                </span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-title">
                <span>Peak Usage Hour</span>
                <span class="badge-tag">Demand</span>
            </div>
            <div class="kpi-value-container">
                <span class="kpi-value">@comparison.PeakUsageHour:00</span>
                <span class="kpi-unit">Avg @comparison.PeakUsageHourKwh.ToString("N2") kWh</span>
            </div>
            <div>
                <span style="font-size: 12px; color: var(--text-secondary);">Highest recurring hourly load</span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-title">
                <span>Range Extrema</span>
                <span class="badge-tag">Min / Max</span>
            </div>
            <div class="kpi-value-container">
                <span class="kpi-value">@minDailyKwh.ToString("N1") / @maxDailyKwh.ToString("N1")</span>
                <span class="kpi-unit">kWh</span>
            </div>
            <div>
                <span style="font-size: 12px; color: var(--text-secondary);">Daily minimum / maximum</span>
            </div>
        </div>
    </div>

    <!-- Charts Row: 24-Hour Diurnal Profile & Daily Bar Chart -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="pulse-card h-100">
                <div class="card-header-flex">
                    <div>
                        <h2 class="card-title-lg">24-Hour Diurnal Profile</h2>
                        <div class="card-subtitle-sm">Average hourly load pattern (00:00 – 23:00)</div>
                    </div>
                </div>
                <div style="height: 280px; position: relative;">
                    <canvas id="hourlyProfileChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="pulse-card h-100">
                <div class="card-header-flex">
                    <div>
                        <h2 class="card-title-lg">Daily Consumption Breakdown</h2>
                        <div class="card-subtitle-sm">Individual daily aggregates for the selected range</div>
                    </div>
                </div>
                <div style="height: 280px; position: relative;">
                    <canvas id="dailyBarChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Monthly Aggregation Trend Table -->
    <div class="pulse-card">
        <div class="card-header-flex">
            <div>
                <h2 class="card-title-lg">Monthly Consumption History</h2>
                <div class="card-subtitle-sm">Consolidated historical performance across recorded months</div>
            </div>
        </div>
        <div class="table-responsive">
            <table class="pulse-table">
                <thead>
                    <tr>
                        <th>Billing Month</th>
                        <th>Observed Days</th>
                        <th>Total Consumption</th>
                        <th>Daily Average</th>
                        <th>Estimated Cost (@(tariff?.Currency))</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in monthlyAggregations)
                    {
                        <tr>
                            <td><strong>@m.MonthName</strong></td>
                            <td>@m.DaysCount days</td>
                            <td>@m.TotalKwh.ToString("N1") kWh</td>
                            <td>@m.AverageDailyKwh.ToString("N1") kWh/d</td>
                            <td>@(tariff?.Currency)@m.EstimatedCost.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Heatmap Table (Hour of Day vs Day of Week) -->
    <div class="pulse-card">
        <div class="card-header-flex">
            <div>
                <h2 class="card-title-lg">Hourly Heatmap by Day of Week</h2>
                <div class="card-subtitle-sm">Color intensity reflects average kilowatt-hour usage</div>
            </div>
        </div>
        <div class="table-responsive">
            <table class="pulse-table" style="font-size: 11px; text-align: center;">
                <thead>
                    <tr>
                        <th style="width: 80px;">Day</th>
                        @for (int h = 0; h < 24; h += 2)
                        {
                            <th colspan="2" style="text-align: center;">@h:00</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (DayOfWeek dow in Enum.GetValues<DayOfWeek>())
                    {
                        <tr>
                            <td style="font-weight: 600; text-align: left;">@dow.ToString().Substring(0, 3)</td>
                            @for (int h = 0; h < 24; h++)
                            {
                                var cell = heatmapPoints.FirstOrDefault(p => p.DayOfWeek == dow && p.Hour == h);
                                double val = cell?.AverageKwh ?? 0.0;
                                string bg = GetHeatmapColor(val);
                                <td style="background-color: @bg; color: @(val > 1.2 ? "#FFF" : "#000"); padding: 6px 2px;"
                                    title="@dow @h:00 - @val.ToString("N2") kWh">
                                    @val.ToString("N1")
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<EnergyReading> allReadings = new();
    private List<EnergyReading> filteredReadings = new();
    private List<EnergyReading> prevFilteredReadings = new();
    private List<DailyEnergyAggregation> dailyAggregations = new();
    private List<MonthlyAggregation> monthlyAggregations = new();
    private List<HeatmapDataPoint> heatmapPoints = new();
    private PeriodComparisonResult comparison = new();

    private TariffPlan? tariff;
    private CarbonFactor? carbonFactor;
    private HouseholdProfile? profile;
    private DateRangeOption selectedOption = DateRangeOption.Last30Days;
    private DateRangeFilter dateRange = new();

    private double minDailyKwh = 0;
    private double maxDailyKwh = 0;

    protected override async Task OnInitializedAsync()
    {
        profile = await StorageService.GetProfileAsync();
        tariff = await StorageService.GetTariffAsync();
        carbonFactor = await StorageService.GetCarbonFactorAsync();
        allReadings = await StorageService.GetAllReadingsAsync();

        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (allReadings.Count == 0) return;

        DateTimeOffset maxDate = allReadings.Max(r => r.Timestamp);
        int cycleDay = profile?.BillingCycleStartDay ?? 1;

        dateRange = EnergyAnalyticsEngine.ResolveDateRange(selectedOption, maxDate, cycleDay);

        filteredReadings = allReadings
            .Where(r => r.Timestamp >= dateRange.StartDate && r.Timestamp <= dateRange.EndDate)
            .OrderBy(r => r.Timestamp)
            .ToList();

        prevFilteredReadings = allReadings
            .Where(r => r.Timestamp >= dateRange.ComparisonStartDate && r.Timestamp < dateRange.ComparisonEndDate)
            .OrderBy(r => r.Timestamp)
            .ToList();

        comparison = EnergyAnalyticsEngine.ComparePeriods(filteredReadings, prevFilteredReadings, tariff, carbonFactor);
        dailyAggregations = EnergyAnalyticsEngine.AggregateDaily(filteredReadings);
        monthlyAggregations = EnergyAnalyticsEngine.AggregateMonthly(allReadings, tariff);
        heatmapPoints = EnergyAnalyticsEngine.GenerateHeatmap(filteredReadings);

        if (dailyAggregations.Count > 0)
        {
            minDailyKwh = dailyAggregations.Min(d => d.TotalKwh);
            maxDailyKwh = dailyAggregations.Max(d => d.TotalKwh);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (filteredReadings.Count > 0)
        {
            await RenderAnalyticsChartsAsync();
        }
    }

    private async Task SetDateRange(DateRangeOption option)
    {
        selectedOption = option;
        ApplyFilter();
        await RenderAnalyticsChartsAsync();
    }

    private async Task RenderAnalyticsChartsAsync()
    {
        try
        {
            // 1. Hourly Profile Chart
            var hourly = EnergyAnalyticsEngine.CalculateHourlyProfile(filteredReadings);
            var hourlyLabels = hourly.Select(h => $"{h.Hour:D2}:00").ToList();
            var hourlyData = hourly.Select(h => h.AverageKwh).ToList();
            await JS.InvokeVoidAsync("powerPulseCharts.renderBarChart",
                "hourlyProfileChart", hourlyLabels, hourlyData, null, "Hourly Avg (kWh)");

            // 2. Daily Bar Chart
            var dailyLabels = dailyAggregations.Select(d => d.Date.ToString("MMM dd")).ToList();
            var dailyData = dailyAggregations.Select(d => d.TotalKwh).ToList();
            var dailyColors = dailyAggregations.Select(d => d.IsWeekend ? "#39BF6D" : "#1DA058").ToList();
            await JS.InvokeVoidAsync("powerPulseCharts.renderBarChart",
                "dailyBarChart", dailyLabels, dailyData, dailyColors, "Daily Usage (kWh)");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rendering analytics charts: {ex.Message}");
        }
    }

    private string GetHeatmapColor(double val)
    {
        if (val <= 0.01) return "#F8FAFC";
        if (val < 0.3) return "#DCFCE7";
        if (val < 0.6) return "#86EFAC";
        if (val < 0.9) return "#39BF6D";
        if (val < 1.3) return "#1DA058";
        return "#1E6A3F";
    }
}
